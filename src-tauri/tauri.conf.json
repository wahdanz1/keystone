{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Keystone",
  "version": "0.1.0",
  "identifier": "com.keystone.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Keystone",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Daniel Wahlgren",
    "category": "Utility",
    "copyright": "Copyright © 2026 Daniel Wahlgren",
    "shortDescription": "Local-first encrypted vault for API keys and dev snippets",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
