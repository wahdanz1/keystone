# Node / pnpm
node_modules/
pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Vite / build output
dist/
dist-ssr/
*.local

# Rust / Cargo (the canonical ignore lives in src-tauri/.gitignore;
# this catches stray target/ dirs anywhere else in the tree)
target/

# Tauri generated files
src-tauri/gen/schemas/

# Environment / secrets
.env
.env.*
!.env.example

# Editor / IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.swp
*.swo

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Logs
logs/
*.log

# Local databases — defense in depth (real DB lives in %APPDATA%, but never commit one if it ends up here)
*.db
*.db-journal
*.sqlite
*.sqlite-journal
